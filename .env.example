# CL-ANM Environment Configuration
# Copy this file to .env and configure your keys and backend preferences:
#   cp .env.example .env

# LLM Backend Selection: 'groq', 'gguf', 'openai', or 'mock'
LLM_BACKEND=groq

# Groq API Configuration (Free Open-Source Inference)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Local GGUF / Vulkan Backend Configuration (AMD Radeon RX 580)
# Uses llama-server or llama-cli with Vulkan backend
LLAMA_CLI_PATH=C:\Users\Sultan\Downloads\llama-b12255-bin-win-vulkan-x64\llama-cli.exe
LLAMA_SERVER_URL=http://127.0.0.1:8080/v1
GGUF_MODEL_PATH=C:\Users\Sultan\Downloads\llama-b12255-bin-win-vulkan-x64\models\Llama-3.2-3B-Instruct-Q4_K_M.gguf
LLAMA_NGL=99
LLAMA_CTX=2048

# OpenAI API Configuration (Optional / Baseline B1)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Global Seed for Reproducibility
GLOBAL_SEED=42

# Execution Mode: 'mininet' (requires root/WSL) or 'sim' (pure NetworkX fluid simulation)
EXECUTION_MODE=mininet

